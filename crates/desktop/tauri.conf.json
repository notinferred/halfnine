{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halfnine",
  "version": "0.2.0",
  "identifier": "com.notinferred.halfnine",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../apps/desktop/dist",
    "beforeDevCommand": "pnpm --filter @halfnine/desktop dev",
    "beforeBuildCommand": "pnpm --filter @halfnine/desktop build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Halfnine",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "A calm PostgreSQL client.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
